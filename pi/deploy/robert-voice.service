[Unit]
Description=Robert voice (wake word + live AI + speech)
After=network-online.target robert.service sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/robert/pi
ExecStart=@HOME@/robert/pi/.venv/bin/python -m robert.voice.service
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
