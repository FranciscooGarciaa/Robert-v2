[Unit]
Description=Robert vision (camera owner + person detection)
After=network-online.target robert.service sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/robert/pi
ExecStart=@HOME@/robert/pi/.venv/bin/python -m robert.vision.service
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
