# Copy to pi/.env (gitignored) and fill in your own values.

# --- Voice: the AI Robert talks with ------------------------------------------------
# Put the API key of the AI you want here. Supported today:
#   gemini  Google Gemini Live. Key from https://aistudio.google.com/apikey
#   openai  ChatGPT's voice model (OpenAI Realtime). Key from https://platform.openai.com/api-keys
#           (a ChatGPT Plus subscription is not an API key: the API is billed apart)
# Another provider (Claude, Mistral...) needs a small adapter: see pi/robert/voice/providers/.
AI_PROVIDER=gemini
AI_API_KEY=
# Optional; empty = the provider's default (gemini-3.8-live / Puck, gpt-realtime / marin)
AI_MODEL=
AI_VOICE=
# Your name: Robert introduces himself as "el robot de <OWNER_NAME>". Empty: just "Robert".
OWNER_NAME=

# --- Motors (ESP32) -------------------------------------------------------------------
ESP32_HOST=robert-motor.local
ESP32_PORT=81
# Must match CONTROL_TOKEN in firmware/robert_motor/secrets.h
ESP32_TOKEN=change-me
MAX_SPEED=180
DEADMAN_MS=300
HTTP_PORT=8000
# LiDAR (WitMotion D6 via CH340). Calibrate OFFSET so an object in front shows at 0.
LIDAR_ENABLED=true
LIDAR_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
# Our robot's values (measured 2026-10-24): calibrate yours with tools/calibrate_lidar.py
LIDAR_OFFSET_DEG=272
LIDAR_CLOCKWISE=true
# Robot model: our robot's size and motion; measure yours (tape + tools/calibrate_motion.py)
ROBOT_LENGTH_M=0.325
ROBOT_WIDTH_M=0.16
ROBOT_MARGIN_M=0.10
LIDAR_X_M=0
LIDAR_Y_M=0
MPS_PER_PWM=0.00475
TRACK_EFF_M=0.848
PWM_DEADBAND=40
# Collision guard (limits every command) and autonomy
GUARD_ENABLED=true
GUARD_BLIND_MAX_SPEED=80
AUTO_MAX_SPEED=100
AUTO_SPIN_SPEED=90
# Memory: a diary per session + memory.json that carries over (robert/memory.py).
# With the SD protected it lives in RAM: pi/scripts/pull_memory.sh copies it to the Mac.
# Stories it starts with: copy pi/memory_seed.example.json to pi/memory_seed.json and write yours.
MEMORY_ENABLED=true
# MEMORY_DIR=~/robert-memory   (default)
