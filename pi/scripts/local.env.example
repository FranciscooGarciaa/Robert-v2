# Copy to pi/scripts/local.env (gitignored): the scripts in pi/scripts read it, so you
# do not have to type these every time. Anything set on the command line wins.
: "${PI:=pi@robert.local}"                          # <user>@<host or IP> of your Pi
: "${SSH_OPTS:=-o HostKeyAlias=robert.local}"       # keeps host-key checks when you use an IP
# : "${HOTSPOT:=My phone}"                          # phone hotspot for street_ready.sh
